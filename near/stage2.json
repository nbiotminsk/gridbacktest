{
  "_comment": "Этап 2: лонг, вход RSI(14)<30 на 1h — уточняем сетку",
  "symbols": ["NEARUSDT"], "positions": ["long"], "periods": [{"years": 1}],
  "entries": ["rsi"], "entry_tfs": [60],
  "defaults": {"deposit": 1000, "leverage": 10, "reinvest": 0, "price_factor": 1.4},
  "grid": {
